# Local development only; copy to .env. Never commit credentials.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=./data/linkedin.sqlite
# Generate independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
MCP_CLIENT_ID=linkedin-copilot-chatgpt
MCP_CLIENT_SECRET=
# Set the exact callback URI shown by your ChatGPT app configuration.
# Multiple values are comma-separated. No wildcards.
MCP_REDIRECT_URIS=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Register PUBLIC_URL + /oauth/linkedin/callback in LinkedIn's developer portal.
# Enable only scopes your LinkedIn app actually holds. Identity only by default.
LINKEDIN_SCOPES=openid profile
# Optional granted scopes: w_member_social r_basicprofile r_liteprofile
# r_member_social r_member_social_feed w_member_social_feed r_member_postAnalytics
LINKEDIN_API_VERSION=202608
ALLOWED_ORIGINS=http://localhost:3000,https://chatgpt.com
